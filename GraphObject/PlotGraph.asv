%G.Nodes.Position = positions;       % Store x/y positions if needed

%{
if currentNode < neighborNode
    % Add edge just once
    edgesSource(end+1) = currentNode;
    edgesTarget(end+1) = neighborNode;
    weights(end+1) = w;
end

%}
